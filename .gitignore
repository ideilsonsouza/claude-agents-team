# Versiona APENAS a base da equipe de agentes (lista de permissão).
# Fica de fora: credenciais, histórico, sessões, projetos, memórias,
# settings, plugins, cache e qualquer arquivo de contexto.
/*
!/.gitignore
!/README.md
!/agents/
!/skills/
!/hooks/
!/bin/
/bin/*
!/bin/team-init
/hooks/*
!/hooks/team-context.py
!/hooks/compact-bash.py
!/hooks/compact-output.py
!/hooks/qmd-reindex.py
!/hooks/orchestrator-guard.py
!/hooks/reviewer-guard.py
!/hooks/team_base.py
!/hooks/domain-guard.py

# Skills: só as escritas pela equipe (terceiros e as específicas de produto ficam fora)
/skills/*
!/skills/delivery-contract/
!/skills/spec-workflow/
!/skills/team-memory/
!/skills/git-conventions/
!/skills/deploy-checklist/
!/skills/backend-standards/
!/skills/backend-go/
!/skills/backend-fastify/
!/skills/backend-adonisjs/
!/skills/frontend-standards/
!/skills/frontend-vue/
!/skills/frontend-react/
!/skills/frontend-astro/
!/skills/design-system/
!/skills/ui-ux/
!/skills/adr-template/
!/skills/sql-standards/
!/skills/knowledge-base/
!/skills/test-strategy/
!/skills/architecture-scalability/
!/skills/backend-bullmq/
!/skills/backend-drizzle/
!/skills/backend-fastify-mqtt/
!/skills/cd-practices/
!/skills/cicd-github-actions/
!/skills/deploy-coolify/
!/skills/deploy-dokploy/
!/skills/find-skills/
!/skills/mqtt-broker/
!/skills/mqtt-contract/
!/skills/observability/
!/skills/postgres-scaling/
!/skills/sandbox-isolated-vm/
!/skills/security-go/
!/skills/security-hardening/
!/skills/security-node/
!/skills/security-python/
!/skills/security-supply-chain/
!/skills/ui-review/

# Segurança extra
*.env
.env*
*.key
*.pem
*credentials*
