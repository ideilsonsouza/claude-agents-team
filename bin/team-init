#!/usr/bin/env python3
"""Ativa a equipe de agentes num projeto, sem poluir o repositório.

- Cria/atualiza .claude/settings.local.json com {"agent": "orchestrator"}:
  qualquer sessão do Claude Code aberta no projeto (terminal, Orca, IDE) já
  começa como orchestrator.
- Ignora o arquivo só localmente, via .git/info/exclude (não toca no .gitignore).
- Orienta a configurar o Orca para copiar o arquivo para cada worktree novo.

Uso: team-init [caminho-do-projeto]   (padrão: diretório atual)
     team-init --off [caminho]        (remove a ativação)
"""
import json, pathlib, subprocess, sys

args = [a for a in sys.argv[1:] if a != "--off"]
desligar = "--off" in sys.argv
alvo = pathlib.Path(args[0] if args else ".").resolve()


def git(*cmd: str) -> str:
    return subprocess.run(["git", "-C", str(alvo), *cmd], capture_output=True, text=True, check=True).stdout.strip()


try:
    raiz = pathlib.Path(git("rev-parse", "--path-format=absolute", "--git-common-dir")).parent
except subprocess.CalledProcessError:
    sys.exit(f"{alvo} não é um repositório git.")

config = raiz / ".claude" / "settings.local.json"
dados = json.loads(config.read_text()) if config.exists() else {}

if desligar:
    dados.pop("agent", None)
    config.write_text(json.dumps(dados, indent=2) + "\n") if dados else config.unlink(missing_ok=True)
    print(f"Equipe desativada em {raiz}")
    sys.exit()

dados["agent"] = "orchestrator"
config.parent.mkdir(exist_ok=True)
config.write_text(json.dumps(dados, indent=2) + "\n")

exclude = raiz / ".git" / "info" / "exclude"
exclude.parent.mkdir(parents=True, exist_ok=True)
linhas = exclude.read_text().splitlines() if exclude.exists() else []
if ".claude/settings.local.json" not in linhas:
    exclude.write_text("\n".join([*linhas, "# equipe de agentes (local)", ".claude/settings.local.json"]) + "\n")

print(f"""Equipe ativada em {raiz}
  • {config.relative_to(raiz)} → agent: orchestrator
  • ignorado localmente em .git/info/exclude (o .gitignore do projeto não foi alterado)

Orca — faça uma vez por repositório:
  Repository settings → Worktree Shared Paths → adicione: .claude/settings.local.json
  Assim cada worktree novo também abre como orchestrator.""")
